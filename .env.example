# Second Brain Agent — Environment Configuration
# Copy to .env and fill in your values

# ============================================
# REQUIRED: Notion Integration
# ============================================
# Get from: https://www.notion.so/profile/integrations
# Share your "🧠 Second Brain" page with the integration
NOTION_API_KEY=secret_xxxxxxxxxxxx

# ============================================
# REQUIRED: Choose ONE LLM Provider
# ============================================

# --- Option A: NVIDIA (Nemotron 3 Ultra, Llama 3.1 405B, etc.) ---
# Free at: https://build.nvidia.com
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi_xxxxxxxxxxxx
# LLM_MODEL=nvidia/nemotron-3-ultra  # Optional: nemotron-3-ultra, nvidia/nemotron-4-340b-instruct, meta/llama-3.1-405b-instruct, meta/llama-3.1-70b-instruct, mistralai/mistral-large-2-instruct

# --- Option B: Groq (Fastest inference - Qwen 3.8 27B / GPT-OSS 120B) ---
# Free at: https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxx
# LLM_MODEL=qwen/qwen3.8-27b  # Optional: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b

# --- Option C: Anthropic (Claude) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# LLM_MODEL=claude-sonnet-5  # Optional

# --- Option D: Any OpenAI-compatible (Ollama, OpenRouter, Together, etc.) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxx  # or OPENAI_API_KEY
# LLM_BASE_URL=https://api.openai.com/v1  # Change for Ollama/OpenRouter/etc.
# LLM_MODEL=gpt-4o-mini

# ============================================
# OPTIONAL: Scheduler Crons (default: Monday mornings)
# ============================================
# Crontab syntax, evaluated in container's local time
DIGEST_CRON="0 8 * * 1"      # Weekly digest: Monday 8:00 AM
HYGIENE_CRON="0 9 * * 1"     # Hygiene pass: Monday 9:00 AM
LINKEDIN_CRON="0 10 * * 1"   # LinkedIn drafts: Monday 10:00 AM

# ============================================
# OPTIONAL: Server Port
# ============================================
PORT=4173